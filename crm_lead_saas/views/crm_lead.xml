<odoo>

    <record model="ir.ui.view" id="crm_lead_form_view">
        <field name="name">crm.lead.form (in crm_lead_saas)</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_form_view_oppor"/>
        <field name="arch" type="xml">
            <page name="lead" position="before">
                <page name="crm_saas_values" string="Saas Values">
                    <group name="crm_lead_saas_values" string="Saas Values">
                        <field name="amount_mrr"/>
                        <field name="amount_arr"/>
                        <field name="amount_nrr"/>
                    </group>
                </page>
            </page>
        </field>
    </record>

